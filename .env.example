# StateAgent Environment Variables
# Copy this file to .env and modify as needed.
# Set DASHSCOPE_API_KEY via system environment variable, not here:
#   export DASHSCOPE_API_KEY=sk-your-key-here

# API endpoint
VLM_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# VLM model (state reasoning, entity extraction, video observation, image prompt generation)
VLM_MODEL=qwen3.5-plus

# Image generation model (Shot 2+ endframe generation)
IMAGE_MODEL=wan2.7-image

# Text-to-video model (Shot 1)
TEXT2VIDEO_MODEL=wan2.2-t2v-plus

# Keyframe-to-video model (Shot 2+)
KF2V_MODEL=wan2.2-kf2v-flash

# Video resolution
VIDEO_SIZE=832*480
